# Staging environment template
COMPOSE_PROJECT_NAME=gis_app_staging
NODE_ENV=production
NGINX_HTTP_PORT=8080

POSTGRES_DB=gis_app_staging
POSTGRES_USER=gis_service
POSTGRES_PASSWORD=replace-in-secret-manager
POSTGRES_PASSWORD_FILE=/run/secrets/db_password

HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true
ENFORCE_HTTPS=true

DB_HOST=db
DB_PORT=5432
DB_NAME=gis_app_staging
DB_USER=gis_service
DB_PASSWORD=replace-in-secret-manager
DB_MAX_CONNECTIONS=25
MIGRATIONS_DIR=/app/infra/migrations

JWT_SECRET=replace-with-32-char-minimum-secret-value
JWT_SECRET_CURRENT=replace-with-32-char-minimum-secret-value
JWT_SECRET_PREVIOUS=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-with-32-char-minimum-refresh-secret
JWT_REFRESH_SECRET_CURRENT=replace-with-32-char-minimum-refresh-secret
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRE=30d
SUPER_ADMIN_EMAIL=superadmin@gov.lb
SUPER_ADMIN_PASSWORD=replace-with-strong-super-admin-password
SUPER_ADMIN_FULL_NAME=GIS Super Administrator

# Docker secrets-style (recommended)
DB_PASSWORD_FILE=/run/secrets/db_password
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_SECRET_CURRENT_FILE=/run/secrets/jwt_secret_current
JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh_secret
JWT_REFRESH_SECRET_CURRENT_FILE=/run/secrets/jwt_refresh_secret_current
METRICS_TOKEN_FILE=/run/secrets/metrics_token

CORS_ORIGIN=https://staging-collector.example.gov.lb
CORS_STRICT=true
CORS_CREDENTIALS=true
API_VERSION_PREFIX=/api/v1
ENABLE_LEGACY_API_PREFIX=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
RATE_LIMIT_AUTH_MAX_REQUESTS=30
RATE_LIMIT_EXPORT_MAX_REQUESTS=50

LOG_LEVEL=info
LOG_PRETTY=false
LOG_TO_FILE=false
AUDIT_LOG_ENABLED=true
METRICS_ENABLED=true
METRICS_TOKEN=

UPLOAD_DIR=./uploads
PHOTO_MAX_SIZE=5242880
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_SIZE=104857600
EXPORT_CLEANUP_INTERVAL_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
# Staging should fail closed if real inbox delivery is not configured.
PASSWORD_RESET_REQUIRE_REAL_DELIVERY=true

# Use your staging transactional email provider here.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.staging.example.gov.lb
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
# This must be a sender identity allowed by the provider/domain.
SMTP_FROM_EMAIL=no-reply@staging.example.gov.lb
SMTP_FROM_NAME=Lebanese GIS Collector
