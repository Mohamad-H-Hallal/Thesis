# Development environment template
COMPOSE_PROJECT_NAME=gis_app
POSTGIS_DATA_VOLUME=gis_app_postgis_data
NODE_ENV=development
NGINX_HTTP_PORT=8088

POSTGRES_DB=gis_app
POSTGRES_USER=gis_user
POSTGRES_PASSWORD=change_me
POSTGRES_PASSWORD_FILE=
POSTGRES_HOST_PORT=54329

HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
ENFORCE_HTTPS=false

DB_HOST=db
DB_PORT=5432
DB_NAME=gis_app
DB_USER=gis_user
DB_PASSWORD=change_me
DB_MAX_CONNECTIONS=20
MIGRATIONS_DIR=/app/infra/migrations

JWT_SECRET=dev-only-jwt-secret-minimum-32-chars
JWT_SECRET_CURRENT=dev-only-jwt-secret-minimum-32-chars
JWT_SECRET_PREVIOUS=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=dev-only-refresh-secret-minimum-32
JWT_REFRESH_SECRET_CURRENT=dev-only-refresh-secret-minimum-32
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRE=30d
SUPER_ADMIN_EMAIL=superadmin@gov.lb
SUPER_ADMIN_PASSWORD=replace-with-strong-super-admin-password
SUPER_ADMIN_FULL_NAME=GIS Super Administrator

CORS_ORIGIN=http://localhost:8088,http://localhost:3000,http://localhost
CORS_STRICT=false
CORS_CREDENTIALS=true
API_VERSION_PREFIX=/api/v1
ENABLE_LEGACY_API_PREFIX=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_AUTH_MAX_REQUESTS=100
RATE_LIMIT_EXPORT_MAX_REQUESTS=100
RATE_LIMIT_STORE=memory
REDIS_URL=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=5000
RATE_LIMIT_WORKLOAD_WINDOW_MS=60000
RATE_LIMIT_IMPORT_MAX_REQUESTS=20
RATE_LIMIT_AI_JOB_MAX_REQUESTS=30
RATE_LIMIT_MAP_MAX_REQUESTS=200
RATE_LIMIT_NOTIFICATION_MAX_REQUESTS=100
RATE_LIMIT_PASSWORD_RESET_MAX_REQUESTS=20
VALKEY_PASSWORD=replace-with-url-safe-random-secret
WORKLOAD_WORKER_MODE=inline
WORKLOAD_WORKER_CONCURRENCY=2
WORKLOAD_POLL_INTERVAL_MS=1000
WORKLOAD_LEASE_MS=300000
WORKLOAD_JOB_TIMEOUT_MS=1800000
WORKLOAD_MAX_ATTEMPTS=3
WORKLOAD_HARD_EXIT_ON_TIMEOUT=false

LOG_LEVEL=debug
LOG_PRETTY=true
LOG_TO_FILE=false
AUDIT_LOG_ENABLED=true
API_DOCS_ENABLED=true
API_DOCS_TOKEN=
METRICS_ENABLED=true
METRICS_TOKEN=dev-metrics-token

UPLOAD_DIR=./uploads
PHOTO_MAX_SIZE=5242880
IMPORT_MAX_SIZE=26214400
MALWARE_SCANNER_MODE=disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_MAX_STREAM_BYTES=31457280
ARCHIVE_MAX_ENTRIES=1000
ARCHIVE_MAX_EXPANDED_BYTES=104857600
ARCHIVE_MAX_ENTRY_BYTES=52428800
ARCHIVE_MAX_COMPRESSION_RATIO=100
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_SIZE=104857600
EXPORT_CLEANUP_INTERVAL_HOURS=24
AI_PIPELINE_ENABLED=false
AI_PIPELINE_ROOT=
AI_PIPELINE_OUTPUT_ROOT=/app/ai-outputs
AI_PYTHON_BIN=python
AI_PIPELINE_TIMEOUT_MS=60000
AI_PIPELINE_MODE=disabled
AI_SERVER_URL=http://ai-server:8000
APP_PUBLIC_API_URL=http://localhost:3000
AI_CALLBACK_BASE_URL=http://api:3000
AI_CALLBACK_SECRET=dev-ai-callback-secret-change-me
AI_SERVER_TIMEOUT_MS=30000
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
RATE_LIMIT_VERIFICATION_MAX_REQUESTS=20
VERIFICATION_HMAC_SECRET=development-contact-verification-secret-change-me
CONTACT_VERIFICATION_TOKEN_EXPIRY_MINUTES=30
VERIFICATION_CODE_EXPIRY_MINUTES=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_BLOCK_MINUTES=15
VERIFICATION_DAILY_TARGET_CAP=10
VERIFICATION_DAILY_ACCOUNT_CAP=20
VERIFICATION_DAILY_IP_CAP=50
VERIFICATION_DAILY_DEVICE_CAP=30
VERIFICATION_PROVIDER_TIMEOUT_MS=10000
PHONE_ACCOUNT_REUSE_LIMIT=3
PHONE_ASSURANCE_MODE=format_only
PHONE_FORMAT_VALIDATION_PROVIDER=libphonenumber
PHONE_VERIFICATION_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# `false` keeps local Mailpit capture enabled for developer machines.
# Switch to `true` only when you expect OTP mail to reach a real inbox.
PASSWORD_RESET_REQUIRE_REAL_DELIVERY=false

# Password reset email mode:
# - `mailpit` keeps mail inside local Docker at http://localhost:8025
# - `smtp` hands mail to a real transactional provider
MAIL_TRANSPORT=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Replace this with a provider-approved sender when MAIL_TRANSPORT=smtp.
SMTP_FROM_EMAIL=no-reply@gis.local
SMTP_FROM_NAME=TerraLeb
