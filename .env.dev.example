# Development environment template
COMPOSE_PROJECT_NAME=gis_app_dev
NODE_ENV=development
NGINX_HTTP_PORT=8088

POSTGRES_DB=gis_app
POSTGRES_USER=gis_user
POSTGRES_PASSWORD=change_me
POSTGRES_PASSWORD_FILE=

HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false
ENFORCE_HTTPS=false

DB_HOST=db
DB_PORT=5432
DB_NAME=gis_app
DB_USER=gis_user
DB_PASSWORD=change_me
DB_MAX_CONNECTIONS=20
MIGRATIONS_DIR=/app/infra/migrations

JWT_SECRET=dev-only-jwt-secret-minimum-32-chars
JWT_SECRET_CURRENT=dev-only-jwt-secret-minimum-32-chars
JWT_SECRET_PREVIOUS=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=dev-only-refresh-secret-minimum-32
JWT_REFRESH_SECRET_CURRENT=dev-only-refresh-secret-minimum-32
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRE=30d
SUPER_ADMIN_EMAIL=superadmin@gov.lb
SUPER_ADMIN_PASSWORD=replace-with-strong-super-admin-password
SUPER_ADMIN_FULL_NAME=GIS Super Administrator

CORS_ORIGIN=http://localhost:8088,http://localhost:3000,http://localhost
CORS_STRICT=false
CORS_CREDENTIALS=true
API_VERSION_PREFIX=/api/v1
ENABLE_LEGACY_API_PREFIX=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_AUTH_MAX_REQUESTS=100
RATE_LIMIT_EXPORT_MAX_REQUESTS=100

LOG_LEVEL=debug
LOG_PRETTY=true
LOG_TO_FILE=false
AUDIT_LOG_ENABLED=true
METRICS_ENABLED=true
METRICS_TOKEN=dev-metrics-token

UPLOAD_DIR=./uploads
PHOTO_MAX_SIZE=5242880
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_SIZE=104857600
EXPORT_CLEANUP_INTERVAL_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
# `false` keeps local Mailpit capture enabled for developer machines.
# Switch to `true` only when you expect OTP mail to reach a real inbox.
PASSWORD_RESET_REQUIRE_REAL_DELIVERY=false

# Password reset email mode:
# - `mailpit` keeps mail inside local Docker at http://localhost:8025
# - `smtp` hands mail to a real transactional provider
MAIL_TRANSPORT=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Replace this with a provider-approved sender when MAIL_TRANSPORT=smtp.
SMTP_FROM_EMAIL=no-reply@gis.local
SMTP_FROM_NAME=Lebanese GIS Collector
