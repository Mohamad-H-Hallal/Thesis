# Generic environment template (local defaults)
# Copy to .env and customize per environment.

COMPOSE_PROJECT_NAME=gis_app
POSTGIS_DATA_VOLUME=gis_app_postgis_data
NODE_ENV=development
NGINX_HTTP_PORT=8088

POSTGRES_DB=gis_app
POSTGRES_USER=gis_user
POSTGRES_PASSWORD=change_me
POSTGRES_PASSWORD_FILE=
POSTGRES_HOST_PORT=54329

HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
ENFORCE_HTTPS=false

DB_HOST=db
DB_PORT=5432
DB_NAME=gis_app
DB_USER=gis_user
DB_PASSWORD=change_me
DB_MAX_CONNECTIONS=20
MIGRATIONS_DIR=/app/infra/migrations

JWT_SECRET=replace-with-32-char-minimum-secret-value
JWT_SECRET_CURRENT=replace-with-32-char-minimum-secret-value
JWT_SECRET_PREVIOUS=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-with-32-char-minimum-refresh-secret
JWT_REFRESH_SECRET_CURRENT=replace-with-32-char-minimum-refresh-secret
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRE=30d
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-super-admin-password
SUPER_ADMIN_FULL_NAME=GIS Super Administrator

# Docker secrets-style optional paths (preferred in staging/prod)
DB_PASSWORD_FILE=
DB_ADMIN_PASSWORD_SECRET_FILE=
DB_RUNTIME_PASSWORD_SECRET_FILE=
JWT_SECRET_FILE=
JWT_SECRET_CURRENT_FILE=
JWT_REFRESH_SECRET_FILE=
JWT_REFRESH_SECRET_CURRENT_FILE=
METRICS_TOKEN_FILE=
API_DOCS_TOKEN_FILE=
API_DOCS_TOKEN_SECRET_FILE=
REDIS_PASSWORD_FILE=
SMTP_PASS_FILE=
SUPER_ADMIN_PASSWORD_FILE=
AI_CALLBACK_SECRET_FILE=

CORS_ORIGIN=http://localhost:8088,http://localhost:3000,http://localhost:8080
CORS_STRICT=false
CORS_CREDENTIALS=true
API_VERSION_PREFIX=/api/v1
ENABLE_LEGACY_API_PREFIX=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_AUTH_MAX_REQUESTS=40
RATE_LIMIT_EXPORT_MAX_REQUESTS=60
RATE_LIMIT_STORE=memory
REDIS_URL=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=5000
RATE_LIMIT_WORKLOAD_WINDOW_MS=60000
RATE_LIMIT_IMPORT_MAX_REQUESTS=6
RATE_LIMIT_AI_JOB_MAX_REQUESTS=10
RATE_LIMIT_MAP_MAX_REQUESTS=60
RATE_LIMIT_NOTIFICATION_MAX_REQUESTS=30
RATE_LIMIT_PASSWORD_RESET_MAX_REQUESTS=5
VALKEY_PASSWORD=replace-with-url-safe-random-secret
WORKLOAD_WORKER_MODE=inline
WORKLOAD_WORKER_CONCURRENCY=2
WORKLOAD_POLL_INTERVAL_MS=1000
WORKLOAD_LEASE_MS=300000
WORKLOAD_JOB_TIMEOUT_MS=1800000
WORKLOAD_MAX_ATTEMPTS=3
WORKLOAD_HARD_EXIT_ON_TIMEOUT=false

LOG_LEVEL=info
LOG_PRETTY=true
LOG_TO_FILE=false
AUDIT_LOG_ENABLED=true
API_DOCS_ENABLED=true
API_DOCS_TOKEN=

# Safe-by-default: keep disabled unless configured.
METRICS_ENABLED=false
METRICS_TOKEN=

UPLOAD_DIR=./uploads
PHOTO_MAX_SIZE=5242880
IMPORT_MAX_SIZE=26214400
IMPORT_MAX_FEATURES=20000
MALWARE_SCANNER_MODE=disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_MAX_STREAM_BYTES=31457280
ARCHIVE_MAX_ENTRIES=1000
ARCHIVE_MAX_EXPANDED_BYTES=104857600
ARCHIVE_MAX_ENTRY_BYTES=52428800
ARCHIVE_MAX_COMPRESSION_RATIO=100
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_SIZE=104857600
EXPORT_CLEANUP_INTERVAL_HOURS=24
NOTIFICATION_MAINTENANCE_INTERVAL_MINUTES=60
NOTIFICATION_EMAIL_BATCH_SIZE=50
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
PUSH_NOTIFICATIONS_ENABLED=false
ANDROID_PUSH_NOTIFICATIONS_ENABLED=false
IOS_PUSH_NOTIFICATIONS_ENABLED=false
NOTIFICATION_PUSH_BATCH_SIZE=100
NOTIFICATION_PUSH_MAX_ATTEMPTS=5
# Docker/container path example. Keep the real admin SDK JSON outside Git.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/app-secrets/firebase-admin/lebanese-gis-collector-df12b-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# AI pipeline bridge (disabled unless explicitly enabled)
# AI_PIPELINE_MODE values: disabled, dry_run, local_ground_truth_export,
# regional_feature_extraction, regional_model_eval, regional_classification,
# regional_vectorization_artifacts, regional_full_review_artifacts.
AI_PIPELINE_ENABLED=false
AI_PIPELINE_ROOT=
# Optional: read-only output artifact root for super-admin AI map preview.
# In Docker dev this can point to a mounted AI outputs directory.
AI_PIPELINE_OUTPUT_ROOT=
AI_PYTHON_BIN=python
AI_PIPELINE_TIMEOUT_MS=60000
AI_PIPELINE_MODE=disabled

# AI server API used by backend-created runs. Flutter never talks to this
# service directly.
AI_SERVER_URL=http://127.0.0.1:8000
APP_PUBLIC_API_URL=http://127.0.0.1:3000
# Used by the Python AI server for callbacks. In Docker Compose use http://api:3000.
AI_CALLBACK_BASE_URL=http://127.0.0.1:3000
AI_CALLBACK_SECRET=dev-ai-callback-secret-change-me
AI_SERVER_TIMEOUT_MS=30000
# Used by the Python AI pipeline to reach Postgres. In Docker Compose this must
# use the internal db service name, not localhost.
AI_DATABASE_URL=postgresql://gis_user:change_me@db:5432/gis_app

PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
# `false` allows local Mailpit capture in development.
# Set to `true` when testing or running real inbox delivery through a transactional provider.
PASSWORD_RESET_REQUIRE_REAL_DELIVERY=false

# Password reset email mode:
# - `mailpit` for local captured mail only
# - `smtp` for real transactional delivery
# Keep real SMTP values only in ignored runtime files like `.env` or `apps/api/.env`.
MAIL_TRANSPORT=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Use a provider-approved sender address when MAIL_TRANSPORT=smtp.
SMTP_FROM_EMAIL=no-reply@gis.local
SMTP_FROM_NAME=Lebanese GIS Collector
