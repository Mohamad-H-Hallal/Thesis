# Production environment template
COMPOSE_PROJECT_NAME=gis_app_prod
POSTGIS_PROD_DATA_VOLUME=gis_app_prod_postgis_data
NODE_ENV=production
NGINX_HTTP_PORT=80

POSTGRES_DB=gis_app_prod
POSTGRES_USER=gis_service
POSTGRES_PASSWORD=replace-in-secret-manager
POSTGRES_PASSWORD_FILE=/run/secrets/db_password

HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true
ENFORCE_HTTPS=true

DB_HOST=db
DB_PORT=5432
DB_NAME=gis_app_prod
DB_USER=gis_service
DB_PASSWORD=replace-in-secret-manager
DB_MAX_CONNECTIONS=30
MIGRATIONS_DIR=/app/infra/migrations

JWT_SECRET=replace-with-32-char-minimum-secret-value
JWT_SECRET_CURRENT=replace-with-32-char-minimum-secret-value
JWT_SECRET_PREVIOUS=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-with-32-char-minimum-refresh-secret
JWT_REFRESH_SECRET_CURRENT=replace-with-32-char-minimum-refresh-secret
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRE=30d
SUPER_ADMIN_EMAIL=superadmin@gov.lb
SUPER_ADMIN_PASSWORD=replace-with-strong-super-admin-password
SUPER_ADMIN_FULL_NAME=GIS Super Administrator

# Docker secrets-style (recommended)
DB_PASSWORD_FILE=/run/secrets/db_password
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_SECRET_CURRENT_FILE=/run/secrets/jwt_secret_current
JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh_secret
JWT_REFRESH_SECRET_CURRENT_FILE=/run/secrets/jwt_refresh_secret_current
METRICS_TOKEN_FILE=/run/secrets/metrics_token

CORS_ORIGIN=https://collector.example.gov.lb
CORS_STRICT=true
CORS_CREDENTIALS=true
API_VERSION_PREFIX=/api/v1
ENABLE_LEGACY_API_PREFIX=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_EXPORT_MAX_REQUESTS=40
RATE_LIMIT_STORE=redis
REDIS_URL=rediss://production-valkey.example.invalid:6379
REDIS_CONNECT_TIMEOUT_MS=5000
RATE_LIMIT_WORKLOAD_WINDOW_MS=60000
RATE_LIMIT_IMPORT_MAX_REQUESTS=6
RATE_LIMIT_AI_JOB_MAX_REQUESTS=10
RATE_LIMIT_MAP_MAX_REQUESTS=60
RATE_LIMIT_NOTIFICATION_MAX_REQUESTS=30
RATE_LIMIT_PASSWORD_RESET_MAX_REQUESTS=5
VALKEY_PASSWORD=replace-with-url-safe-random-secret
WORKLOAD_WORKER_MODE=external
WORKLOAD_WORKER_CONCURRENCY=2
WORKLOAD_POLL_INTERVAL_MS=1000
WORKLOAD_LEASE_MS=300000
WORKLOAD_JOB_TIMEOUT_MS=1800000
WORKLOAD_MAX_ATTEMPTS=3
WORKLOAD_HARD_EXIT_ON_TIMEOUT=true

LOG_LEVEL=info
LOG_PRETTY=false
LOG_TO_FILE=false
AUDIT_LOG_ENABLED=true
# Disabled by default. If enabled in production, METRICS_TOKEN (or METRICS_TOKEN_FILE) must be set.
METRICS_ENABLED=false
METRICS_TOKEN=

UPLOAD_DIR=./uploads
PHOTO_MAX_SIZE=5242880
IMPORT_MAX_SIZE=26214400
MALWARE_SCANNER_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_MAX_STREAM_BYTES=31457280
ARCHIVE_MAX_ENTRIES=1000
ARCHIVE_MAX_EXPANDED_BYTES=104857600
ARCHIVE_MAX_ENTRY_BYTES=52428800
ARCHIVE_MAX_COMPRESSION_RATIO=100
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_SIZE=104857600
EXPORT_CLEANUP_INTERVAL_HOURS=24
AI_PIPELINE_ENABLED=false
AI_PIPELINE_ROOT=
AI_PIPELINE_OUTPUT_ROOT=/app/ai-outputs
AI_PYTHON_BIN=python
AI_PIPELINE_TIMEOUT_MS=60000
AI_PIPELINE_MODE=disabled
AI_SERVER_URL=http://ai-server:8000
APP_PUBLIC_API_URL=https://collector.example.gov.lb
AI_CALLBACK_BASE_URL=http://api:3000
AI_CALLBACK_SECRET=replace-with-strong-ai-callback-secret
AI_SERVER_TIMEOUT_MS=30000
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
# Production must fail closed if real inbox delivery is not configured.
PASSWORD_RESET_REQUIRE_REAL_DELIVERY=true

# Use your production transactional email provider here.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.gov.lb
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
# This must be a sender identity allowed by the provider/domain.
SMTP_FROM_EMAIL=no-reply@example.gov.lb
SMTP_FROM_NAME=Lebanese GIS Collector
