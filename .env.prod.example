# =============================================================================
# Global compose settings
# =============================================================================
COMPOSE_PROJECT_NAME=gis_app
NODE_ENV=production

# =============================================================================
# Postgres / PostGIS
# =============================================================================
POSTGRES_DB=gis_app
POSTGRES_USER=gis_user
POSTGRES_PASSWORD=change_me_strong_password

# =============================================================================
# API networking
# =============================================================================
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true
ENFORCE_HTTPS=false

# =============================================================================
# API database connection
# =============================================================================
DB_HOST=db
DB_PORT=5432
DB_NAME=gis_app
DB_USER=gis_user
DB_PASSWORD=change_me_strong_password
DB_MAX_CONNECTIONS=20
MIGRATIONS_DIR=/app/infra/migrations

# =============================================================================
# Auth / JWT (replace all placeholders in real deployments)
# =============================================================================
JWT_SECRET=replace-with-32-char-minimum-secret-value
JWT_SECRET_CURRENT=replace-with-32-char-minimum-secret-value
JWT_SECRET_PREVIOUS=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-with-32-char-minimum-refresh-secret
JWT_REFRESH_SECRET_CURRENT=replace-with-32-char-minimum-refresh-secret
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRE=30d

# =============================================================================
# CORS and API routing
# =============================================================================
CORS_ORIGIN=https://collector.example.gov.lb,https://staging.collector.example.gov.lb
CORS_STRICT=true
CORS_CREDENTIALS=true
API_VERSION_PREFIX=/api/v1
ENABLE_LEGACY_API_PREFIX=false

# =============================================================================
# Rate limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_EXPORT_MAX_REQUESTS=40

# =============================================================================
# Logging and observability
# =============================================================================
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-strong-metrics-token

# =============================================================================
# Upload and export storage
# =============================================================================
UPLOAD_DIR=./uploads
PHOTO_MAX_SIZE=5242880
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_SIZE=104857600
EXPORT_CLEANUP_INTERVAL_HOURS=24
