# Production environment template
COMPOSE_PROJECT_NAME=gis_app_prod
API_ENV_FILE=.env
POSTGIS_PROD_DATA_VOLUME=gis_app_prod_postgis_data
NODE_ENV=production
PUBLIC_HOSTNAME=collector.example.gov.lb
CERTBOT_EMAIL=operations@example.gov.lb
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

POSTGRES_DB=gis_app_prod
POSTGRES_USER=gis_owner
POSTGRES_PASSWORD=
DB_RUNTIME_USER=gis_runtime

HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
ENFORCE_HTTPS=true

DB_HOST=db
DB_PORT=5432
DB_NAME=gis_app_prod
DB_USER=gis_runtime
DB_PASSWORD=
DB_MAX_CONNECTIONS=30
MIGRATIONS_DIR=/app/infra/migrations

JWT_SECRET=
JWT_SECRET_CURRENT=
JWT_SECRET_PREVIOUS=
JWT_EXPIRE=15m
JWT_ISSUER=terraleb-api
JWT_AUDIENCE=terraleb-mobile
JWT_REFRESH_SECRET=
JWT_REFRESH_SECRET_CURRENT=
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRE=30d
SUPER_ADMIN_EMAIL=superadmin@gov.lb
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=GIS Super Administrator

# Host paths consumed by compose.prod.yml. Real files are ignored by Git.
DB_ADMIN_PASSWORD_SECRET_FILE=./secrets/db_admin_password.txt
DB_RUNTIME_PASSWORD_SECRET_FILE=./secrets/db_runtime_password.txt
JWT_SECRET_FILE_HOST=./secrets/jwt_secret.txt
JWT_REFRESH_SECRET_FILE_HOST=./secrets/jwt_refresh_secret.txt
REDIS_PASSWORD_SECRET_FILE=./secrets/redis_password.txt
METRICS_TOKEN_SECRET_FILE=./secrets/metrics_token.txt
SMTP_PASSWORD_SECRET_FILE=./secrets/smtp_password.txt
SUPER_ADMIN_PASSWORD_SECRET_FILE=./secrets/super_admin_password.txt
AI_CALLBACK_SECRET_FILE_HOST=./secrets/ai_callback_secret.txt
AI_INTERNAL_API_SECRET_FILE_HOST=./secrets/ai_internal_api_secret.txt
API_DOCS_TOKEN_SECRET_FILE=./secrets/api_docs_token.txt
PRIVACY_EXPORT_ENCRYPTION_KEY_SECRET_FILE=./secrets/privacy_export_encryption_key.txt
VERIFICATION_HMAC_SECRET_FILE_HOST=./secrets/verification_hmac_secret.txt
FIREBASE_SERVICE_ACCOUNT_SECRET_FILE=./secrets/firebase_service_account.json
OCI_S3_ACCESS_KEY_ID_SECRET_FILE=./secrets/oci_s3_access_key_id.txt
OCI_S3_SECRET_ACCESS_KEY_SECRET_FILE=./secrets/oci_s3_secret_access_key.txt
OCI_BACKUP_S3_ACCESS_KEY_ID_SECRET_FILE=./secrets/oci_backup_s3_access_key_id.txt
OCI_BACKUP_S3_SECRET_ACCESS_KEY_SECRET_FILE=./secrets/oci_backup_s3_secret_access_key.txt
BACKUP_ENCRYPTION_KEY_SECRET_FILE=./secrets/backup_encryption_key.txt
ARCGIS_CLIENT_ID_SECRET_FILE=./secrets/arcgis_client_id.txt
ARCGIS_CLIENT_SECRET_FILE=./secrets/arcgis_client_secret.txt
GEE_SERVICE_ACCOUNT_SECRET_FILE=./secrets/gee_service_account.json

CORS_ORIGIN=https://collector.example.gov.lb
CORS_STRICT=true
CORS_CREDENTIALS=true
API_VERSION_PREFIX=/api/v1
ENABLE_LEGACY_API_PREFIX=false

# Real-time v2 is authoritative. Keep the legacy broadcaster and polling
# fallback off for a new production deployment after the staging pilot passes.
REALTIME_V2_ENABLED=true
REALTIME_LEGACY_BROADCAST_ENABLED=false
REALTIME_POLLING_FALLBACK_ENABLED=false
REALTIME_AUTH_TIMEOUT_MS=5000
REALTIME_HEARTBEAT_INTERVAL_MS=30000
REALTIME_MAX_CONNECTIONS_PER_USER=5
REALTIME_MAX_CONNECTIONS_PER_IP=30
REALTIME_MAX_BUFFERED_BYTES=262144

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_EXPORT_MAX_REQUESTS=40
RATE_LIMIT_STORE=redis
REDIS_URL=rediss://production-valkey.example.invalid:6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=5000
RATE_LIMIT_WORKLOAD_WINDOW_MS=60000
RATE_LIMIT_IMPORT_MAX_REQUESTS=6
RATE_LIMIT_AI_JOB_MAX_REQUESTS=10
RATE_LIMIT_MAP_MAX_REQUESTS=60
RATE_LIMIT_NOTIFICATION_MAX_REQUESTS=30
RATE_LIMIT_PASSWORD_RESET_MAX_REQUESTS=5
RATE_LIMIT_VERIFICATION_MAX_REQUESTS=20
RATE_LIMIT_PRIVACY_REQUEST_MAX_REQUESTS=10
RATE_LIMIT_PUBLIC_PRIVACY_REQUEST_MAX_REQUESTS=5
RATE_LIMIT_CONTENT_REPORT_MAX_REQUESTS=20
OFFLINE_SYNC_RATE_LIMIT_WINDOW_MS=60000
OFFLINE_SYNC_RATE_LIMIT_MAX_REQUESTS=60
OFFLINE_SYNC_INGRESS_RATE_LIMIT_MAX_REQUESTS=240
WORKLOAD_WORKER_MODE=external
WORKLOAD_WORKER_CONCURRENCY=2
WORKLOAD_POLL_INTERVAL_MS=1000
WORKLOAD_LEASE_MS=300000
WORKLOAD_JOB_TIMEOUT_MS=1800000
WORKLOAD_MAX_ATTEMPTS=3
WORKLOAD_HARD_EXIT_ON_TIMEOUT=true

LOG_LEVEL=info
LOG_PRETTY=false
LOG_TO_FILE=false
LOG_DIR=./logs/api
LOG_MAX_SIZE=20m
LOG_RETENTION_DAYS=30
AUDIT_LOG_ENABLED=true
API_DOCS_ENABLED=false
API_DOCS_TOKEN=
METRICS_ENABLED=true
METRICS_TOKEN=

UPLOAD_DIR=./uploads
PHOTO_MAX_SIZE=5242880
PHOTO_MAX_WIDTH=10000
PHOTO_MAX_HEIGHT=10000
PHOTO_MAX_PIXELS=40000000
IMPORT_MAX_SIZE=26214400
IMPORT_MAX_FEATURES=20000
MALWARE_SCANNER_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_MAX_STREAM_BYTES=31457280
ARCHIVE_MAX_ENTRIES=1000
ARCHIVE_MAX_EXPANDED_BYTES=104857600
ARCHIVE_MAX_ENTRY_BYTES=52428800
ARCHIVE_MAX_COMPRESSION_RATIO=100
# Local storage remains the default for development. Production uses the OCI
# S3-compatible endpoint with five private, purpose-separated buckets.
STORAGE_DRIVER=s3
STORAGE_TEMP_DIR=/tmp/terraleb-storage
STORAGE_MAX_OBJECT_BYTES=5368709120
STORAGE_S3_ENDPOINT=https://replace-namespace.compat.objectstorage.me-jeddah-1.oraclecloud.com
STORAGE_S3_REGION=me-jeddah-1
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_UPLOADS_BUCKET=terraleb-prod-uploads
STORAGE_S3_EXPORTS_BUCKET=terraleb-prod-exports
STORAGE_S3_OFFLINE_BUCKET=terraleb-prod-offline
STORAGE_S3_AI_BUCKET=terraleb-prod-ai
STORAGE_S3_BACKUPS_BUCKET=terraleb-prod-backups
STORAGE_S3_PREFIX=terraleb
STORAGE_S3_REQUEST_TIMEOUT_MS=30000
STORAGE_S3_MAX_ATTEMPTS=3
STORAGE_S3_SERVER_SIDE_ENCRYPTION=AES256
# The backup service uses separate bucket-only credentials and application-layer
# AES-256-GCM. Keep this key separate from privacy-export encryption.
BACKUP_ENCRYPTION_KEY_BASE64=
BACKUP_ENCRYPTION_KEY_ID=primary
BACKUP_TEMP_DIR=/backup-work
BACKUP_MAX_BYTES=21474836480
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_SIZE=104857600
EXPORT_CLEANUP_INTERVAL_HOURS=24
# The 32-byte base64 key is supplied through the Docker secret file above.
PRIVACY_EXPORT_DIR=./exports/privacy
PRIVACY_EXPORT_ENCRYPTION_KEY_BASE64=
PRIVACY_EXPORT_ENCRYPTION_KEY_ID=primary
# Owner-approved security target: 24 hours. Production still fails closed until the
# owner/counsel-approved retention decision has an immutable reference below.
PRIVACY_EXPORT_TTL_HOURS=24
PRIVACY_EXPORT_RETENTION_APPROVAL_REFERENCE=
PRIVACY_EXPORT_MAX_BYTES=52428800

# Deletion stays fail-closed until the revised discard/retention policy is
# implemented, tested, and every approval reference below is recorded.
ACCOUNT_DELETION_EXECUTION_ENABLED=false
ACCOUNT_DELETION_POLICY_APPROVAL_REFERENCE=
ACCOUNT_DELETION_RETENTION_APPROVAL_REFERENCE=
MASKED_CONTRIBUTOR_POLICY_APPROVAL_REFERENCE=
RETAINED_GIS_RECORDS_APPROVAL_REFERENCE=
ACCEPTED_MEDIA_LOCATION_APPROVAL_REFERENCE=
FREE_TEXT_TREATMENT_APPROVAL_REFERENCE=
BACKUP_AGEING_APPROVAL_REFERENCE=

NOTIFICATION_MAINTENANCE_INTERVAL_MINUTES=60
PUSH_NOTIFICATIONS_ENABLED=true
ANDROID_PUSH_NOTIFICATIONS_ENABLED=true
IOS_PUSH_NOTIFICATIONS_ENABLED=false
NOTIFICATION_PUSH_BATCH_SIZE=100
NOTIFICATION_PUSH_MAX_ATTEMPTS=5
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase_service_account

# Draft legal text must never be public in production. Enforcement and import
# provenance remain off until exact approved documents/evidence are recorded.
LEGAL_DRAFTS_PUBLIC_ENABLED=false
LEGAL_ENFORCEMENT_ENABLED=false
LEGAL_COUNSEL_APPROVAL_REFERENCE=
IMPORT_PROVENANCE_ENFORCEMENT_ENABLED=false

# AI is globally available, while every project remains disabled by default
# until the protected super administrator enables it. The production image
# must be an immutable digest produced from the reviewed AI repository.
AI_PIPELINE_ENABLED=true
AI_PIPELINE_ROOT=
AI_PIPELINE_OUTPUT_ROOT=/app/ai-outputs
AI_PYTHON_BIN=python
AI_PIPELINE_TIMEOUT_MS=60000
AI_PIPELINE_MODE=regional_full_review_artifacts
AI_SERVER_URL=http://ai-server:8000
APP_PUBLIC_API_URL=https://collector.example.gov.lb
AI_CALLBACK_BASE_URL=http://api:3000
AI_CALLBACK_SECRET=
AI_INTERNAL_API_SECRET=
AI_SERVER_TIMEOUT_MS=30000
AI_MAX_CONCURRENT_RUNS=2
AI_MAX_RUNS_PER_PROJECT_PER_DAY=4
AI_MAX_ESTIMATED_COST_USD_PER_RUN=25
AI_SERVER_IMAGE=replace-with-registry/terraleb-ai@sha256:replace-with-immutable-digest
AI_SERVER_PLATFORM=linux/amd64
AI_SERVER_MEMORY_LIMIT=12g
AI_SERVER_CPU_LIMIT=4
AI_SERVER_PIDS_LIMIT=512
AI_SERVER_SOURCE_REPOSITORY=https://github.com/mribrahim314/AI-ML-pipeline-for-AI-Enhanced-Mobile-GIS.git
AI_SERVER_SOURCE_COMMIT=ed06c63a231e8d3d711239acbfa65f017ca7ac07
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_ASSET_FOLDER=
GEE_SERVICE_ACCOUNT_PATH=/run/secrets/gee_service_account

# Hybrid tiles are fetched by the API with operator-owned credentials. No
# ArcGIS secret is embedded in Flutter. Keep false until the account evidence
# and restricted production credentials are ready.
ARCGIS_ONLINE_ENABLED=false
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=
ARCGIS_TOKEN_URL=https://www.arcgis.com/sharing/rest/oauth2/token
ARCGIS_IMAGERY_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
ARCGIS_REFERENCE_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}
ARCGIS_ATTRIBUTION_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/attribution
ARCGIS_REQUEST_TIMEOUT_MS=10000
ARCGIS_TOKEN_REFRESH_SKEW_SECONDS=300
ARCGIS_MAX_TILE_BYTES=5242880
ARCGIS_DAILY_TILE_SOFT_LIMIT=100000
ARCGIS_ALLOWED_HOSTS=www.arcgis.com,services.arcgisonline.com,server.arcgisonline.com
RATE_LIMIT_MAP_TILE_MAX_REQUESTS=3000
MAP_PROVIDER_USER_AGENT=TerraLeb/1.0 (+https://replace-domain.example/legal/important-notices; contact: replace-privacy-email@example.com)

# Provider-neutral authenticated packages replace Esri bulk tile caching.
# Enable only after an approved Copernicus/OSM-derived package manifest and
# checksum are stored in the private offline bucket.
OFFLINE_PACKAGE_ENABLED=false
OFFLINE_PACKAGE_DIR=./offline-packages
OFFLINE_PACKAGE_MAX_BYTES=5368709120
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
VERIFICATION_HMAC_SECRET=replace-with-a-dedicated-random-contact-verification-secret
CONTACT_VERIFICATION_TOKEN_EXPIRY_MINUTES=30
VERIFICATION_CODE_EXPIRY_MINUTES=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_BLOCK_MINUTES=15
VERIFICATION_DAILY_TARGET_CAP=10
VERIFICATION_DAILY_ACCOUNT_CAP=20
VERIFICATION_DAILY_IP_CAP=50
VERIFICATION_DAILY_DEVICE_CAP=30
VERIFICATION_PROVIDER_TIMEOUT_MS=10000
PHONE_ACCOUNT_REUSE_LIMIT=3
PHONE_ASSURANCE_MODE=format_only
PHONE_FORMAT_VALIDATION_PROVIDER=libphonenumber
PHONE_VERIFICATION_PROVIDER=twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Production must fail closed if real inbox delivery is not configured.
PASSWORD_RESET_REQUIRE_REAL_DELIVERY=true

# Use your production transactional email provider here.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.gov.lb
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=
# This must be a sender identity allowed by the provider/domain.
SMTP_FROM_EMAIL=no-reply@example.gov.lb
SMTP_FROM_NAME=TerraLeb
