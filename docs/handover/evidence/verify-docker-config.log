name: gis_app
services:
  api:
    build:
      context: D:\GIS_APP
      dockerfile: apps/api/Dockerfile
    depends_on:
      db:
        condition: service_healthy
        required: true
      migrate:
        condition: service_completed_successfully
        required: true
    environment:
      API_VERSION_PREFIX: /api/v1
      AUDIT_LOG_ENABLED: "true"
      COMPOSE_PROJECT_NAME: gis_app
      CORS_CREDENTIALS: "true"
      CORS_ORIGIN: http://localhost:8088,http://localhost:3000,http://localhost:8080
      CORS_STRICT: "false"
      DB_HOST: db
      DB_MAX_CONNECTIONS: "20"
      DB_NAME: gis_app
      DB_PASSWORD: change_me
      DB_PASSWORD_FILE: ""
      DB_PORT: "5432"
      DB_USER: gis_user
      ENABLE_LEGACY_API_PREFIX: "true"
      ENFORCE_HTTPS: "false"
      EXPORT_CLEANUP_INTERVAL_HOURS: "24"
      EXPORT_DIR: ./exports
      EXPORT_MAX_SIZE: "104857600"
      EXPORT_RETENTION_DAYS: "7"
      HOST: 0.0.0.0
      JWT_EXPIRE: 7d
      JWT_REFRESH_EXPIRE: 30d
      JWT_REFRESH_SECRET: replace-with-32-char-minimum-refresh-secret
      JWT_REFRESH_SECRET_CURRENT: replace-with-32-char-minimum-refresh-secret
      JWT_REFRESH_SECRET_CURRENT_FILE: ""
      JWT_REFRESH_SECRET_FILE: ""
      JWT_REFRESH_SECRET_PREVIOUS: ""
      JWT_SECRET: replace-with-32-char-minimum-secret-value
      JWT_SECRET_CURRENT: replace-with-32-char-minimum-secret-value
      JWT_SECRET_CURRENT_FILE: ""
      JWT_SECRET_FILE: ""
      JWT_SECRET_PREVIOUS: ""
      LOG_LEVEL: info
      LOG_PRETTY: "true"
      LOG_TO_FILE: "false"
      METRICS_ENABLED: "false"
      METRICS_TOKEN: ""
      METRICS_TOKEN_FILE: ""
      MIGRATIONS_DIR: /app/infra/migrations
      NGINX_HTTP_PORT: "8080"
      NODE_ENV: production
      PHOTO_MAX_SIZE: "5242880"
      PORT: "3000"
      POSTGRES_DB: gis_app
      POSTGRES_PASSWORD: change_me
      POSTGRES_USER: gis_user
      RATE_LIMIT_AUTH_MAX_REQUESTS: "40"
      RATE_LIMIT_EXPORT_MAX_REQUESTS: "60"
      RATE_LIMIT_MAX_REQUESTS: "200"
      RATE_LIMIT_WINDOW_MS: "900000"
      TRUST_PROXY: "false"
      UPLOAD_DIR: ./uploads
    expose:
      - "3000"
    healthcheck:
      test:
        - CMD-SHELL
        - node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
      timeout: 5s
      interval: 30s
      retries: 5
      start_period: 30s
    networks:
      default: null
    restart: unless-stopped
    volumes:
      - type: volume
        source: api_uploads
        target: /app/apps/api/uploads
        volume: {}
      - type: volume
        source: api_exports
        target: /app/apps/api/exports
        volume: {}
      - type: bind
        source: D:\GIS_APP\secrets
        target: /run/secrets
        read_only: true
        bind: {}
  db:
    environment:
      API_VERSION_PREFIX: /api/v1
      AUDIT_LOG_ENABLED: "true"
      COMPOSE_PROJECT_NAME: gis_app
      CORS_CREDENTIALS: "true"
      CORS_ORIGIN: http://localhost:8088,http://localhost:3000,http://localhost:8080
      CORS_STRICT: "false"
      DB_HOST: db
      DB_MAX_CONNECTIONS: "20"
      DB_NAME: gis_app
      DB_PASSWORD: change_me
      DB_PASSWORD_FILE: ""
      DB_PORT: "5432"
      DB_USER: gis_user
      ENABLE_LEGACY_API_PREFIX: "true"
      ENFORCE_HTTPS: "false"
      EXPORT_CLEANUP_INTERVAL_HOURS: "24"
      EXPORT_DIR: ./exports
      EXPORT_MAX_SIZE: "104857600"
      EXPORT_RETENTION_DAYS: "7"
      HOST: 0.0.0.0
      JWT_EXPIRE: 7d
      JWT_REFRESH_EXPIRE: 30d
      JWT_REFRESH_SECRET: replace-with-32-char-minimum-refresh-secret
      JWT_REFRESH_SECRET_CURRENT: replace-with-32-char-minimum-refresh-secret
      JWT_REFRESH_SECRET_CURRENT_FILE: ""
      JWT_REFRESH_SECRET_FILE: ""
      JWT_REFRESH_SECRET_PREVIOUS: ""
      JWT_SECRET: replace-with-32-char-minimum-secret-value
      JWT_SECRET_CURRENT: replace-with-32-char-minimum-secret-value
      JWT_SECRET_CURRENT_FILE: ""
      JWT_SECRET_FILE: ""
      JWT_SECRET_PREVIOUS: ""
      LOG_LEVEL: info
      LOG_PRETTY: "true"
      LOG_TO_FILE: "false"
      METRICS_ENABLED: "false"
      METRICS_TOKEN: ""
      METRICS_TOKEN_FILE: ""
      MIGRATIONS_DIR: /app/infra/migrations
      NGINX_HTTP_PORT: "8080"
      NODE_ENV: development
      PHOTO_MAX_SIZE: "5242880"
      PORT: "3000"
      POSTGRES_DB: gis_app
      POSTGRES_PASSWORD: change_me
      POSTGRES_PASSWORD_FILE: ""
      POSTGRES_USER: gis_user
      RATE_LIMIT_AUTH_MAX_REQUESTS: "40"
      RATE_LIMIT_EXPORT_MAX_REQUESTS: "60"
      RATE_LIMIT_MAX_REQUESTS: "200"
      RATE_LIMIT_WINDOW_MS: "900000"
      TRUST_PROXY: "false"
      UPLOAD_DIR: ./uploads
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}
      timeout: 5s
      interval: 10s
      retries: 10
      start_period: 20s
    image: postgis/postgis:16-3.4
    networks:
      default: null
    restart: unless-stopped
    volumes:
      - type: volume
        source: postgis_data
        target: /var/lib/postgresql/data
        volume: {}
      - type: bind
        source: D:\GIS_APP\infra\db\init
        target: /docker-entrypoint-initdb.d
        read_only: true
        bind: {}
  migrate:
    build:
      context: D:\GIS_APP
      dockerfile: apps/api/Dockerfile
    depends_on:
      db:
        condition: service_healthy
        required: true
    entrypoint:
      - node
      - dist/db/migrate.js
    environment:
      API_VERSION_PREFIX: /api/v1
      AUDIT_LOG_ENABLED: "true"
      COMPOSE_PROJECT_NAME: gis_app
      CORS_CREDENTIALS: "true"
      CORS_ORIGIN: http://localhost:8088,http://localhost:3000,http://localhost:8080
      CORS_STRICT: "false"
      DB_HOST: db
      DB_MAX_CONNECTIONS: "20"
      DB_NAME: gis_app
      DB_PASSWORD: change_me
      DB_PASSWORD_FILE: ""
      DB_PORT: "5432"
      DB_USER: gis_user
      ENABLE_LEGACY_API_PREFIX: "true"
      ENFORCE_HTTPS: "false"
      EXPORT_CLEANUP_INTERVAL_HOURS: "24"
      EXPORT_DIR: ./exports
      EXPORT_MAX_SIZE: "104857600"
      EXPORT_RETENTION_DAYS: "7"
      HOST: 0.0.0.0
      JWT_EXPIRE: 7d
      JWT_REFRESH_EXPIRE: 30d
      JWT_REFRESH_SECRET: replace-with-32-char-minimum-refresh-secret
      JWT_REFRESH_SECRET_CURRENT: replace-with-32-char-minimum-refresh-secret
      JWT_REFRESH_SECRET_CURRENT_FILE: ""
      JWT_REFRESH_SECRET_FILE: ""
      JWT_REFRESH_SECRET_PREVIOUS: ""
      JWT_SECRET: replace-with-32-char-minimum-secret-value
      JWT_SECRET_CURRENT: replace-with-32-char-minimum-secret-value
      JWT_SECRET_CURRENT_FILE: ""
      JWT_SECRET_FILE: ""
      JWT_SECRET_PREVIOUS: ""
      LOG_LEVEL: info
      LOG_PRETTY: "true"
      LOG_TO_FILE: "false"
      METRICS_ENABLED: "false"
      METRICS_TOKEN: ""
      METRICS_TOKEN_FILE: ""
      MIGRATIONS_DIR: /app/infra/migrations
      NGINX_HTTP_PORT: "8080"
      NODE_ENV: production
      PHOTO_MAX_SIZE: "5242880"
      PORT: "3000"
      POSTGRES_DB: gis_app
      POSTGRES_PASSWORD: change_me
      POSTGRES_USER: gis_user
      RATE_LIMIT_AUTH_MAX_REQUESTS: "40"
      RATE_LIMIT_EXPORT_MAX_REQUESTS: "60"
      RATE_LIMIT_MAX_REQUESTS: "200"
      RATE_LIMIT_WINDOW_MS: "900000"
      TRUST_PROXY: "false"
      UPLOAD_DIR: ./uploads
    networks:
      default: null
    restart: "no"
  nginx:
    depends_on:
      api:
        condition: service_healthy
        required: true
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
      timeout: 5s
      interval: 30s
      retries: 5
      start_period: 15s
    image: nginxinc/nginx-unprivileged:1.27-alpine
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8080"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: bind
        source: D:\GIS_APP\infra\nginx\nginx.conf
        target: /etc/nginx/conf.d/default.conf
        read_only: true
        bind: {}
      - type: bind
        source: D:\GIS_APP\apps\mobile\build\web
        target: /usr/share/nginx/html
        read_only: true
        bind: {}
networks:
  default:
    name: gis_app_default
volumes:
  api_exports:
    name: gis_app_api_exports
  api_uploads:
    name: gis_app_api_uploads
  postgis_data:
    name: gis_app_postgis_data
