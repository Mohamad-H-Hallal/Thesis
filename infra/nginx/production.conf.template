map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=connections_per_ip:10m;

log_format structured escape=json
    '{"timestamp":"$time_iso8601","service":"gis-edge","request_id":"$request_id",'
    '"remote_addr":"$remote_addr","method":"$request_method","path":"$uri",'
    '"status":$status,"bytes_sent":$body_bytes_sent,"duration_seconds":$request_time,'
    '"upstream_duration_seconds":"$upstream_response_time"}';

upstream gis_api {
    server api:3000;
    keepalive 64;
}

server {
    listen 8080;
    server_name ${PUBLIC_HOSTNAME};
    server_tokens off;

    access_log /dev/stdout structured;
    error_log /dev/stderr warn;

    if ($host != ${PUBLIC_HOSTNAME}) {
        return 421;
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://${PUBLIC_HOSTNAME}$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${PUBLIC_HOSTNAME};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${PUBLIC_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOSTNAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log /dev/stdout structured;
    error_log /dev/stderr warn;

    if ($host != ${PUBLIC_HOSTNAME}) {
        return 421;
    }

    client_max_body_size 26m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 60s;
    limit_conn connections_per_ip 30;

    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    location = /health {
        proxy_pass http://gis_api/health;
        proxy_set_header Host ${PUBLIC_HOSTNAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    location = /ready {
        return 404;
    }

    location = /metrics {
        return 404;
    }

    location ^~ /docs/ {
        return 404;
    }

    location = /docs {
        return 404;
    }

    location = /api/v1/realtime/workflow {
        limit_req zone=api_per_ip burst=10 nodelay;
        limit_conn connections_per_ip 10;
        proxy_pass http://gis_api;
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_HOSTNAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
    }

    location /api/ {
        limit_req zone=api_per_ip burst=60 nodelay;
        proxy_pass http://gis_api;
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_HOSTNAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
