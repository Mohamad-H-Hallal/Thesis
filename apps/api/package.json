{
  "name": "lebanese-gis-backend",
  "version": "1.0.0",
  "description": "Backend API for Lebanese GIS Mobile Application",
  "main": "dist/server.js",
  "scripts": {
    "pretest": "npm run build",
    "pretest:ci": "npm run test:db:prepare",
    "pretest:unit": "npm run test:db:prepare",
    "pretest:phase3": "npm run test:db:prepare",
    "pretest:e2e": "npm run test:db:prepare",
    "pretest:perf:bbox": "npm run test:db:prepare",
    "pretest:perf:exports": "npm run test:db:prepare",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:docker": "nodemon --legacy-watch --watch src --watch docs --ext ts,yaml --exec \"tsx src/server.ts\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs --coverage --runInBand",
    "test:db:prepare": "tsx src/db/prepareTestDb.ts",
    "test:ci": "jest --config jest.config.cjs --coverage --runInBand --ci --testPathIgnorePatterns test/phase10.performance",
    "test:unit": "jest --config jest.config.cjs --runInBand test/app.test.js",
    "test:phase3": "jest --config jest.config.cjs --runInBand test/phase3.integration.test.js",
    "test:e2e": "jest --config jest.config.cjs --runInBand test/phase10.e2e.workflow.test.js",
    "test:perf:bbox": "jest --config jest.config.cjs --runInBand test/phase10.performance.bbox.test.js",
    "test:perf:exports": "jest --config jest.config.cjs --runInBand test/phase10.performance.exports.test.js",
    "test:perf": "npm run test:perf:bbox && npm run test:perf:exports",
    "openapi:check": "node scripts/check-openapi.js",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "migrate": "tsx src/db/migrate.ts",
    "reset:runtime": "tsx src/db/resetRuntime.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:staging": "tsx src/db/seedStaging.ts",
    "staging:verify": "tsx src/db/stagingVerify.ts",
    "ai:worker:once": "tsx src/jobs/runAiWorkerOnce.ts --once --mock",
    "ai:worker:dry-run": "tsx src/jobs/runAiWorkerOnce.ts --once --dry-run",
    "ai:worker:bridge-once": "tsx src/jobs/runAiWorkerOnce.ts --once --pipeline-bridge",
    "notifications:run": "tsx src/jobs/runNotificationMaintenance.ts",
    "phase11:staging": "npm run migrate && npm run seed:staging && npm run staging:verify",
    "release:gate": "npm run openapi:check && npm run lint && npm run typecheck && npm run test:ci && npm run test:perf && npm run audit:prod",
    "migrate:prod": "node dist/db/migrate.js"
  },
  "keywords": [
    "gis",
    "geospatial",
    "postgis",
    "mobile",
    "lebanon"
  ],
  "author": "Ibrahim",
  "license": "MIT",
  "dependencies": {
    "@mapbox/shp-write": "^0.4.3",
    "@tmcw/togeojson": "^7.1.2",
    "@xmldom/xmldom": "^0.9.10",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.18.0",
    "protobufjs": "7.6.4",
    "sharp": "^0.33.1",
    "shpjs": "^6.2.0",
    "winston": "^3.19.0",
    "ws": "^8.21.0"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "lodash": "4.18.1",
    "@tootallnate/once": "3.0.1",
    "protobufjs": "7.6.4"
  },
  "devDependencies": {
    "@swc/core": "^1.13.6",
    "@swc/jest": "^0.2.39",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.5.3",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "5.5.4"
  }
}
