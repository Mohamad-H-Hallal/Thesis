# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
ENFORCE_HTTPS=false

# Database Configuration
DB_HOST=localhost
# Default local API commands target the official root Docker compose DB on 54329.
DB_PORT=54329
DB_NAME=gis_app
DB_USER=gis_user
DB_PASSWORD=change_me
DB_MAX_CONNECTIONS=20

# JWT Configuration
JWT_SECRET=change-me-very-long-random-secret
JWT_SECRET_CURRENT=change-me-very-long-random-secret
JWT_SECRET_PREVIOUS=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change-me-very-long-random-refresh-secret
JWT_REFRESH_SECRET_CURRENT=change-me-very-long-random-refresh-secret
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRE=30d
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-super-admin-password
SUPER_ADMIN_FULL_NAME=GIS Super Administrator

# File Upload Configuration
UPLOAD_DIR=./uploads
PHOTO_MAX_SIZE=5242880
IMPORT_MAX_SIZE=26214400
IMPORT_MAX_FEATURES=20000
MALWARE_SCANNER_MODE=disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_MAX_STREAM_BYTES=31457280
ARCHIVE_MAX_ENTRIES=1000
ARCHIVE_MAX_EXPANDED_BYTES=104857600
ARCHIVE_MAX_ENTRY_BYTES=52428800
ARCHIVE_MAX_COMPRESSION_RATIO=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_STRICT=true
CORS_CREDENTIALS=true
API_VERSION_PREFIX=/api/v1
ENABLE_LEGACY_API_PREFIX=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_EXPORT_MAX_REQUESTS=10
RATE_LIMIT_STORE=memory
REDIS_URL=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=5000
RATE_LIMIT_WORKLOAD_WINDOW_MS=60000
RATE_LIMIT_IMPORT_MAX_REQUESTS=6
RATE_LIMIT_AI_JOB_MAX_REQUESTS=10
RATE_LIMIT_MAP_MAX_REQUESTS=60
RATE_LIMIT_NOTIFICATION_MAX_REQUESTS=30
RATE_LIMIT_PASSWORD_RESET_MAX_REQUESTS=5
RATE_LIMIT_VERIFICATION_MAX_REQUESTS=20
# Production must use RATE_LIMIT_STORE=redis and a managed Redis/Valkey URL.

# Durable import/export worker
WORKLOAD_WORKER_MODE=inline
WORKLOAD_WORKER_CONCURRENCY=2
WORKLOAD_POLL_INTERVAL_MS=1000
WORKLOAD_LEASE_MS=300000
WORKLOAD_JOB_TIMEOUT_MS=1800000
WORKLOAD_MAX_ATTEMPTS=3
WORKLOAD_HARD_EXIT_ON_TIMEOUT=false
# Production must run a separate worker with WORKLOAD_WORKER_MODE=external and
# WORKLOAD_HARD_EXIT_ON_TIMEOUT=true. The API never drains jobs in external mode.

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
LOG_TO_FILE=false

# Observability and audit
AUDIT_LOG_ENABLED=true
API_DOCS_ENABLED=true
API_DOCS_TOKEN=
METRICS_ENABLED=false
METRICS_TOKEN=
# In production, set METRICS_ENABLED=true only with METRICS_TOKEN configured

# Export settings
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_SIZE=104857600
EXPORT_CLEANUP_INTERVAL_HOURS=24
NOTIFICATION_MAINTENANCE_INTERVAL_MINUTES=60
PUSH_NOTIFICATIONS_ENABLED=false
ANDROID_PUSH_NOTIFICATIONS_ENABLED=false
IOS_PUSH_NOTIFICATIONS_ENABLED=false
NOTIFICATION_PUSH_BATCH_SIZE=100
NOTIFICATION_PUSH_MAX_ATTEMPTS=5
# Keep the real admin SDK JSON outside Git and point to it from local env only.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_PATH=

# AI pipeline bridge (disabled unless explicitly enabled)
# AI_PIPELINE_MODE values: disabled, dry_run, local_ground_truth_export,
# regional_feature_extraction, regional_model_eval, regional_classification,
# regional_vectorization_artifacts.
AI_PIPELINE_ENABLED=false
AI_PIPELINE_ROOT=
# Optional: read-only output artifact root for super-admin AI map preview.
# In Docker dev this can point to a mounted AI outputs directory.
AI_PIPELINE_OUTPUT_ROOT=
AI_PYTHON_BIN=python
AI_PIPELINE_TIMEOUT_MS=60000
AI_PIPELINE_MODE=disabled

# AI server API used by backend-created runs. Flutter never talks to this
# service directly.
AI_SERVER_URL=http://127.0.0.1:8000
APP_PUBLIC_API_URL=http://127.0.0.1:3000
# Used by the Python AI server for callbacks. In Docker Compose use http://api:3000.
AI_CALLBACK_BASE_URL=http://127.0.0.1:3000
AI_CALLBACK_SECRET=dev-ai-callback-secret-change-me
AI_SERVER_TIMEOUT_MS=30000

PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15

# Contact ownership verification. Generate VERIFICATION_HMAC_SECRET with a
# cryptographically secure secret manager; never reuse JWT or provider secrets.
VERIFICATION_HMAC_SECRET=development-verification-hmac-secret-change-me
CONTACT_VERIFICATION_TOKEN_EXPIRY_MINUTES=30
VERIFICATION_CODE_EXPIRY_MINUTES=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_BLOCK_MINUTES=15
VERIFICATION_DAILY_TARGET_CAP=10
VERIFICATION_DAILY_ACCOUNT_CAP=20
VERIFICATION_DAILY_IP_CAP=50
VERIFICATION_DAILY_DEVICE_CAP=30
VERIFICATION_PROVIDER_TIMEOUT_MS=10000
# format_only validates Lebanese mobile structure without claiming ownership.
# sms_otp requires Twilio Verify and sets phone_verified_at.
PHONE_ACCOUNT_REUSE_LIMIT=3
PHONE_ASSURANCE_MODE=format_only
PHONE_FORMAT_VALIDATION_PROVIDER=libphonenumber
# Used only when PHONE_ASSURANCE_MODE=sms_otp.
PHONE_VERIFICATION_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Host-side local API commands default to local Mailpit capture.
# Switch this to `true` only when your host-side API process should require real SMTP delivery.
PASSWORD_RESET_REQUIRE_REAL_DELIVERY=false

# Local host-side defaults:
# - MAIL_TRANSPORT=mailpit
# - SMTP_HOST=localhost
# - SMTP_PORT=1025
# Keep real SMTP values only in ignored runtime files like `.env` or `apps/api/.env`.
# To send real OTP emails, switch to MAIL_TRANSPORT=smtp and provide real SMTP_* values.
MAIL_TRANSPORT=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Replace this with a provider-approved sender when MAIL_TRANSPORT=smtp.
SMTP_FROM_EMAIL=no-reply@gis.local
SMTP_FROM_NAME=TerraLeb
