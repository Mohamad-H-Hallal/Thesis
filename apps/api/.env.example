# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost
TRUST_PROXY=false
ENFORCE_HTTPS=false

# Database Configuration
DB_HOST=localhost
# Default local API commands target the official root Docker compose DB on 55433.
DB_PORT=55433
DB_NAME=gis_app
DB_USER=gis_user
DB_PASSWORD=change_me
DB_MAX_CONNECTIONS=20

# JWT Configuration
JWT_SECRET=change-me-very-long-random-secret
JWT_SECRET_CURRENT=change-me-very-long-random-secret
JWT_SECRET_PREVIOUS=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change-me-very-long-random-refresh-secret
JWT_REFRESH_SECRET_CURRENT=change-me-very-long-random-refresh-secret
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRE=30d
SUPER_ADMIN_EMAIL=superadmin@gov.lb
SUPER_ADMIN_PASSWORD=ChangeThis!Gov2026
SUPER_ADMIN_FULL_NAME=GIS Super Administrator

# File Upload Configuration
UPLOAD_DIR=./uploads
PHOTO_MAX_SIZE=5242880

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_STRICT=true
CORS_CREDENTIALS=true
API_VERSION_PREFIX=/api/v1
ENABLE_LEGACY_API_PREFIX=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_EXPORT_MAX_REQUESTS=40

# Logging
LOG_LEVEL=info

# Observability and audit
AUDIT_LOG_ENABLED=true
METRICS_ENABLED=false
METRICS_TOKEN=
# In production, set METRICS_ENABLED=true only with METRICS_TOKEN configured

# Export settings
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_SIZE=104857600
EXPORT_CLEANUP_INTERVAL_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
PASSWORD_RESET_REQUIRE_REAL_DELIVERY=false

MAIL_TRANSPORT=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@gis.local
SMTP_FROM_NAME=Lebanese GIS Collector
