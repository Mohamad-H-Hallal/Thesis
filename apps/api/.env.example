# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost
TRUST_PROXY=false
ENFORCE_HTTPS=false

# Database Configuration
DB_HOST=localhost
# Default local API commands target the official root Docker compose DB on 55433.
DB_PORT=55433
DB_NAME=gis_app
DB_USER=gis_user
DB_PASSWORD=change_me
DB_MAX_CONNECTIONS=20

# JWT Configuration
JWT_SECRET=change-me-very-long-random-secret
JWT_SECRET_CURRENT=change-me-very-long-random-secret
JWT_SECRET_PREVIOUS=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change-me-very-long-random-refresh-secret
JWT_REFRESH_SECRET_CURRENT=change-me-very-long-random-refresh-secret
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRE=30d
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-super-admin-password
SUPER_ADMIN_FULL_NAME=GIS Super Administrator

# File Upload Configuration
UPLOAD_DIR=./uploads
PHOTO_MAX_SIZE=5242880
IMPORT_MAX_SIZE=26214400
IMPORT_MAX_FEATURES=2000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_STRICT=true
CORS_CREDENTIALS=true
API_VERSION_PREFIX=/api/v1
ENABLE_LEGACY_API_PREFIX=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_EXPORT_MAX_REQUESTS=40

# Logging
LOG_LEVEL=info

# Observability and audit
AUDIT_LOG_ENABLED=true
METRICS_ENABLED=false
METRICS_TOKEN=
# In production, set METRICS_ENABLED=true only with METRICS_TOKEN configured

# Export settings
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_SIZE=104857600
EXPORT_CLEANUP_INTERVAL_HOURS=24
NOTIFICATION_MAINTENANCE_INTERVAL_MINUTES=60
NOTIFICATION_EMAIL_BATCH_SIZE=50
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
PUSH_NOTIFICATIONS_ENABLED=false
ANDROID_PUSH_NOTIFICATIONS_ENABLED=false
IOS_PUSH_NOTIFICATIONS_ENABLED=false
NOTIFICATION_PUSH_BATCH_SIZE=100
NOTIFICATION_PUSH_MAX_ATTEMPTS=5
# Keep the real admin SDK JSON outside Git and point to it from local env only.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_PATH=
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
# Host-side local API commands default to local Mailpit capture.
# Switch this to `true` only when your host-side API process should require real SMTP delivery.
PASSWORD_RESET_REQUIRE_REAL_DELIVERY=false

# Local host-side defaults:
# - MAIL_TRANSPORT=mailpit
# - SMTP_HOST=localhost
# - SMTP_PORT=1025
# Keep real SMTP values only in ignored runtime files like `.env` or `apps/api/.env`.
# To send real OTP emails, switch to MAIL_TRANSPORT=smtp and provide real SMTP_* values.
MAIL_TRANSPORT=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Replace this with a provider-approved sender when MAIL_TRANSPORT=smtp.
SMTP_FROM_EMAIL=no-reply@gis.local
SMTP_FROM_NAME=Lebanese GIS Collector
